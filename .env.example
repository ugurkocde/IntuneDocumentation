# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Azure AD configuration for Vercel and local development builds
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="your_client_id_here"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="common"

# Docker and self-hosted deployments set these when the container starts.
# AZURE_AD_CLIENT_ID="your_client_id_here"
# AZURE_AD_TENANT_ID="common"

# Analytics defaults to off for self-hosters. The hosted site sets this to "true".
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Optional Crisp support chat. Leave unset for Docker/self-hosted deployments.
# NEXT_PUBLIC_CRISP_WEBSITE_ID="your_crisp_website_id"

# Hosted support form at /support (public origin only). All four are required.
# Resend sender must belong to a verified domain. Never use the visitor as From.
# RESEND_API_KEY="re_..."
# SUPPORT_FROM_EMAIL="Intune Documentation <support@ugurlabs.com>"
# SUPPORT_TURNSTILE_SITE_KEY="your_turnstile_site_key"
# SUPPORT_TURNSTILE_SECRET_KEY="your_turnstile_secret_key"

# Desktop app licensing API at /api/desktop-license. All six are required;
# the routes answer 503 when any is missing. Server only, never NEXT_PUBLIC.
# The access token is an organization access token with license_keys:write,
# benefits:read and subscriptions:read. Generate the signing key with
# apps/desktop/scripts/generate-license-keypair.mjs and build the desktop app
# with the matching public key.
# POLAR_API_BASE="https://sandbox-api.polar.sh"
# POLAR_ORGANIZATION_ID="your_polar_organization_id"
# POLAR_ACCESS_TOKEN="polar_oat_..."
# DESKTOP_LICENSE_PRO_BENEFIT_ID="your_pro_license_benefit_id"
# DESKTOP_LICENSE_MSP_BENEFIT_ID="your_msp_license_benefit_id"
# DESKTOP_LICENSE_SIGNING_KEY="base64_of_ed25519_pkcs8_pem"

# Desktop app pricing page at /desktop. Public Polar checkout links for the four
# desktop products and the Polar customer portal. All optional: unset checkout
# links fall back to the production checkout links in src/lib/desktop-app.ts and
# the portal to polar.sh/ugurlabs/portal.
# NEXT_PUBLIC_POLAR_CHECKOUT_PRO_MONTHLY="https://buy.polar.sh/polar_cl_..."
# NEXT_PUBLIC_POLAR_CHECKOUT_PRO_YEARLY="https://buy.polar.sh/polar_cl_..."
# NEXT_PUBLIC_POLAR_CHECKOUT_MSP_MONTHLY="https://buy.polar.sh/polar_cl_..."
# NEXT_PUBLIC_POLAR_CHECKOUT_MSP_YEARLY="https://buy.polar.sh/polar_cl_..."
# NEXT_PUBLIC_POLAR_PORTAL_URL="https://polar.sh/your_org_slug/portal"

# Desktop app update feed (/api/desktop-update). Both optional.
# GITHUB_RELEASES_TOKEN raises the GitHub API rate limit for the release lookup.
# DESKTOP_UPDATE_PINNED_TAG holds every installation at one release, for example desktop-v0.1.0 (rollback switch).
# GITHUB_RELEASES_TOKEN=
# DESKTOP_UPDATE_PINNED_TAG=
